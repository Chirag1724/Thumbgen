#  ThumbGen — Root .gitignore
#  Covers: client (Vite + React + TS) & server (Node + Express + TS)

# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Build Outputs
dist/
dist-ssr/
build/
client/dist/
server/dist/

# Environment Variables (NEVER commit secrets)
# Server secrets: SESSION_SECRET, MONGODB_URI, GEMINI_API_KEY, CLOUDINARY_URL
# Client secrets: VITE_BASE_URL
.env
.env.local
.env.development
.env.production
.env.test
.env.development.local
.env.test.local
.env.production.local
client/.env
client/.env.local
client/.env.development
client/.env.production
server/.env
server/.env.local
server/.env.development
server/.env.production

# TypeScript Cache
*.tsbuildinfo
client/*.tsbuildinfo
server/*.tsbuildinfo

# Vite Cache
.vite/
client/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
*.local
.cache/
.temp/
.tmp/
